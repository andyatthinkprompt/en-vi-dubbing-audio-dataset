{"pair_id":"spk_002_000003","speaker_id":"spk_002","gender":"male","original_source_speaker":"jellyfish1010_0004","vi_audio":"speakers\/spk_002\/vi\/000003.wav","vi_text":"Nhận thức rõ ràng về chính mình và người khác có thể thay đổi cuộc sống của chúng ta theo rất nhiều cách thức.","vi_duration":5.83,"en_audio":"speakers\/spk_002\/en\/000003.mp3","en_text":"A clear awareness of oneself and others can transform our lives in many different ways.","en_duration":4.69,"reference_audio_ids":["spk_002_ref_combined","spk_002_ref_01","spk_002_ref_02","spk_002_ref_03","spk_002_ref_04","spk_002_ref_05","spk_002_ref_06","spk_002_ref_07","spk_002_ref_08","spk_002_ref_09","spk_002_ref_10"],"translation_model":"NLLB-200 \/ Helsinki-NLP","dubbing_provider":"ElevenLabs","dubbing_model":"eleven_multilingual_v2","speaker_similarity_vi_en":0.9695,"split":"validation"}
{"pair_id":"spk_002_000004","speaker_id":"spk_002","gender":"male","original_source_speaker":"jellyfish1010_0004","vi_audio":"speakers\/spk_002\/vi\/000004.wav","vi_text":"Do đó bạn không được vội vã xét đoán mà phải cởi mở tấm lòng để học hỏi nhiều hơn.","vi_duration":5.43,"en_audio":"speakers\/spk_002\/en\/000004.mp3","en_text":"Therefore, you must not rush to judge, but should open your heart to learn more.","en_duration":4.23,"reference_audio_ids":["spk_002_ref_combined","spk_002_ref_01","spk_002_ref_02","spk_002_ref_03","spk_002_ref_04","spk_002_ref_05","spk_002_ref_06","spk_002_ref_07","spk_002_ref_08","spk_002_ref_09","spk_002_ref_10"],"translation_model":"NLLB-200 \/ Helsinki-NLP","dubbing_provider":"ElevenLabs","dubbing_model":"eleven_multilingual_v2","speaker_similarity_vi_en":0.9828,"split":"validation"}
